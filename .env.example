# Copier ce fichier en .env et renseigner les valeurs. Ne jamais le committer.

# Jeton Duffel (commence par duffel_test_ en mode test).
# Laisser vide pour utiliser le mode simulé (aucun appel à Duffel).
DUFFEL_ACCESS_TOKEN=
# En mode test, n'afficher que Duffel Airways (seule compagnie qui crée réellement des options en test)
TEST_HOLD_DUFFEL_AIRWAYS_ONLY=true

# Nom affiché sur le site et dans les PDF
APP_NAME=VisaFlight
# URL publique (liens dans les e-mails)
BASE_URL=https://visaflight.creationapp.academy

# Base de données (SQLite par défaut ; en Docker, docker-compose.yml impose /app/data/app.db)
DATABASE_URL=sqlite:///./data/app.db

# E-mail (laisser SMTP_HOST vide pour afficher les e-mails dans les logs)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@creationapp.academy

# --- Déploiement Docker / Traefik (voir DEPLOIEMENT.md) ---
DOMAIN=visaflight.creationapp.academy
TRAEFIK_NETWORK=web
TRAEFIK_HTTP_ENTRYPOINT=web
TRAEFIK_HTTPS_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
