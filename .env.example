# Copier ce fichier en .env et renseigner les valeurs.

# Jeton Duffel (commence par duffel_test_ en mode test).
# Laisser vide pour utiliser le mode simulé (aucun appel à Duffel).
DUFFEL_ACCESS_TOKEN=

# Nom affiché sur le site et dans les PDF
APP_NAME=VisaFlight
# URL publique (liens dans les e-mails)
BASE_URL=http://localhost:8000

# Base de données (SQLite par défaut)
DATABASE_URL=sqlite:///./data/app.db

# E-mail (laisser SMTP_HOST vide pour afficher les e-mails dans la console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
